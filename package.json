{
  "name": "youtube-unchained",
  "version": "1.0.0",
  "description": "An extensible, user-controlled YouTube interface customization browser extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsx scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "tsx tests/behavioral-browser-test.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "youtube",
    "browser-extension",
    "customization",
    "chromium",
    "vivaldi",
    "chrome",
    "manifest-v3"
  ],
  "author": "YouTube Unchained Contributors",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
